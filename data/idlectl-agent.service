####################################################################################
# idlectl-agent -- the unprivileged per-session agent.
#
# THIS UNIT IS NOT ENABLED BY THE PACKAGE. There is no user preset and no install
# hook. Enable it in the session that should report facts:
#
#     systemctl --user enable --now idlectl-agent.service
#
# It reports two things and it never decides:
#
#   * how long this session has been idle, from ext-idle-notify-v1 on Wayland or the
#     MIT-SCREEN-SAVER counter on X11;
#   * whether an MPRIS player in this session is playing.
#
# Both are session-scoped and neither is reachable from outside the session. The second
# is not a stylistic choice: A ROOT DAEMON CANNOT CONNECT TO A USER SESSION BUS. The
# connection is accepted at the socket and then closed during authentication, because a
# session bus serves exactly one uid, and no file permission changes that.
#
# It does NOT attribute GPU load or look for running games. The daemon reads /proc for
# itself; putting those here would mean trusting an unprivileged process's claims about
# what is running on the machine, and there is no reason to.
#
# IT ACTS IN EXACTLY ONE WAY, AND THAT IS THE SCREEN.
#
# Blanking a display is not a power transition and logind has no mechanism for it: on
# a Wayland session only the compositor, or whatever holds DRM master, can turn an
# output off. So this agent exports Blank/Unblank on the system bus, callable by uid 0
# alone, and idlepolicyd invokes them when screen_off comes due. The daemon decides;
# the agent performs, inside its own session. It can suspend, hibernate or power off
# nothing, and no configuration can give it those.
#
# WITHOUT THIS AGENT, ON A MACHINE THAT HAS A GRAPHICAL SESSION, THE DAEMON WILL NOT
# LET THE MACHINE SLEEP. That is deliberate and it is not a bug: a compositor is
# running, so somebody could be sitting in front of it, and nothing is in a position
# to say otherwise. human_active reads `indeterminate`, which vetoes every sleep
# action, and `idlectl doctor` says exactly that and exits non-zero.
#
# On a machine with NO graphical session -- a server, a headless box woken by a relay
# to run a job -- the daemon reads that as "nobody is at the keyboard", which is
# correct, and the machine follows its schedule normally. Do not run this agent there:
# starting it and letting it fail turns the working case into the wedged one.
#
# screen_off is separate. Where no agent offers a blanking mechanism it reports
# `unavailable` as an ACTION -- the daemon does not propose it, blocks that set a
# screen_off key are inert, and `idlectl doctor` names them. An action that is absent
# raises no veto on anything: that is knowledge, not doubt.
####################################################################################

[Unit]
Description=idlectl session agent
Documentation=man:idlectl(1) man:idlepolicyd(8)
PartOf=graphical-session.target
After=graphical-session.target

# No Condition*= here either, and for the same reason as in idlepolicyd.service: a
# skipped unit is a silent unit. In particular there is no check for "is this a
# Wayland session" -- the agent detects its own backend, tries Wayland then X11, and
# exits non-zero with both errors named if neither works. A unit that failed to start
# with a message beats one that was skipped with none.

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/idlectl-agent
Restart=on-failure
RestartSec=5s

# A daemon that restarted has forgotten this agent and refuses its reports. The agent
# re-registers rather than exiting, so an idlepolicyd upgrade does not require every
# logged-in user to restart their session.
Environment=IDLECTL_LOG=info

# ---------------------------------------------------------------------------------
# Sandboxing
#
# CAVEAT for all of the below: sandboxing in a *user* unit is applied by the user
# manager and needs unprivileged user namespaces. On a kernel where
# kernel.unprivileged_userns_clone is disabled these directives cause the unit to
# fail to start rather than to start unsandboxed -- which is the correct direction,
# but it does mean "the agent will not start" has a boring answer. Check with:
#
#     systemctl --user show idlectl-agent.service -p Result -p StatusErrno
#     sysctl kernel.unprivileged_userns_clone
# ---------------------------------------------------------------------------------
NoNewPrivileges=yes

# Belt and braces: a process started by a user manager has no capabilities to begin
# with. The empty set makes that explicit rather than assumed, and survives somebody
# later wondering whether the agent could be given one.
CapabilityBoundingSet=
AmbientCapabilities=

ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

# NOT relaxed. The agent reads no file under any home directory: its two inputs are a
# compositor protocol and an X server extension, both reached over sockets in
# XDG_RUNTIME_DIR. If a future version needs to read something under /home, this line
# is the deliberate obstacle it has to argue past.
ProtectHome=yes

# NOT relaxed either, for the same reason: the agent inspects no process but its own.
# Process inspection lives in the daemon, which is privileged and does not have to
# take an unprivileged process's word for what is running.
ProtectProc=invisible
ProcSubset=pid

# The Wayland socket, the session bus and the system bus are all AF_UNIX. The agent
# opens no network socket. An X11 session reached over TCP rather than over its unix
# socket is not supported, deliberately: a display exported over the network is not a
# reliable statement about whether somebody is physically present.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete @reboot @swap @cpu-emulation

[Install]
# Present so `systemctl --user enable` works. Nothing in the packaging invokes it.
WantedBy=graphical-session.target
