####################################################################################
# idlectl-agent -- the unprivileged per-session agent.
#
# THIS UNIT IS NOT ENABLED BY THE PACKAGE. There is no user preset and no install
# hook. Enable it in the session that should report facts:
#
#     systemctl --user enable --now idlectl-agent.service
#
# It reports three things and it never decides:
#
#   * how long this session has been idle, from ext-idle-notify-v1 on Wayland or the
#     MIT-SCREEN-SAVER counter on X11;
#   * whether an MPRIS player in this session is playing;
#   * which of this session's processes hold GPU memory, from DRM fdinfo under /proc.
#
# None of the three is reachable from outside the session, and the last two are not
# stylistic choices. A ROOT DAEMON CANNOT CONNECT TO A USER SESSION BUS: the connection
# is accepted at the socket and then closed during authentication, because a session bus
# serves exactly one uid, and no file permission changes that. And /proc/<pid>/fdinfo is
# mode 0555 yet still gated by ptrace_may_access, so reading ANOTHER user's needs
# CAP_SYS_PTRACE -- measured: denied with the daemon's CAP_DAC_READ_SEARCH, granted with
# CAP_SYS_PTRACE. Handing the component that can power the machine off the right to read
# any process's memory, so that video RAM can be attributed, is not a trade worth making.
# Here the processes are this uid's own and no capability is needed at all.
#
# What it sends is RAW: pid, process name, bytes. It does NOT attribute GPU memory to a
# game and does not look for running games. The daemon does that from the process tree
# and the command lines, which are world-readable; putting it here would mean trusting an
# unprivileged process's claims about what is running on the machine, and there is no
# reason to.
#
# IT ACTS IN EXACTLY ONE WAY, AND THAT IS THE SCREEN.
#
# Blanking a display is not a power transition and logind has no mechanism for it: on
# a Wayland session only the compositor, or whatever holds DRM master, can turn an
# output off. So this agent exports Blank/Unblank on the system bus, callable by uid 0
# alone, and idlepolicyd invokes them when screen_off comes due. The daemon decides;
# the agent performs, inside its own session. It can suspend, hibernate or power off
# nothing, and no configuration can give it those.
#
# WITHOUT THIS AGENT, ON A MACHINE THAT HAS A GRAPHICAL SESSION, THE DAEMON WILL NOT
# LET THE MACHINE SLEEP. That is deliberate and it is not a bug: a compositor is
# running, so somebody could be sitting in front of it, and nothing is in a position
# to say otherwise. human_active reads `indeterminate`, which vetoes every sleep
# action, and `idlectl doctor` says exactly that and exits non-zero.
#
# On a machine with NO graphical session -- a server, a headless box woken by a relay
# to run a job -- the daemon reads that as "nobody is at the keyboard", which is
# correct, and the machine follows its schedule normally. Do not run this agent there:
# starting it and letting it fail turns the working case into the wedged one.
#
# screen_off is separate. Where no agent offers a blanking mechanism it reports
# `unavailable` as an ACTION -- the daemon does not propose it, blocks that set a
# screen_off key are inert, and `idlectl doctor` names them. An action that is absent
# raises no veto on anything: that is knowledge, not doubt.
####################################################################################

[Unit]
Description=idlectl session agent
Documentation=man:idlectl(1) man:idlepolicyd(8)
PartOf=graphical-session.target
After=graphical-session.target

# No Condition*= here either, and for the same reason as in idlepolicyd.service: a
# skipped unit is a silent unit. In particular there is no check for "is this a
# Wayland session" -- the agent detects its own backend, tries Wayland then X11, and
# exits non-zero with both errors named if neither works. A unit that failed to start
# with a message beats one that was skipped with none.

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/idlectl-agent
Restart=on-failure
RestartSec=5s

# A daemon that restarted has forgotten this agent and refuses its reports. The agent
# re-registers rather than exiting, so an idlepolicyd upgrade does not require every
# logged-in user to restart their session.
Environment=IDLECTL_LOG=info

# ---------------------------------------------------------------------------------
# Sandboxing
#
# CAVEAT for all of the below: sandboxing in a *user* unit is applied by the user
# manager and needs unprivileged user namespaces. On a kernel where
# kernel.unprivileged_userns_clone is disabled these directives cause the unit to
# fail to start rather than to start unsandboxed -- which is the correct direction,
# but it does mean "the agent will not start" has a boring answer. Check with:
#
#     systemctl --user show idlectl-agent.service -p Result -p StatusErrno
#     sysctl kernel.unprivileged_userns_clone
# ---------------------------------------------------------------------------------
# EVERY DIRECTIVE HERE IS ONE THAT DOES NOT NEED A NAMESPACE, AND THAT IS NOT A
# PREFERENCE. It is the difference between this agent seeing GPU memory and seeing none.
#
# A *user* unit cannot be given a mount namespace by an unprivileged user manager without
# an unprivileged USER namespace as well, and `CapabilityBoundingSet=` needs one too --
# dropping your own bounding set requires CAP_SETPCAP, so without a user namespace the
# unit dies at startup with status=218/CAPABILITIES. Measured on a live session:
#
#     shell, or a user unit with none of these:   user:[4026531837]   (the initial one)
#     the same unit plus PrivateTmp=yes:          user:[4026532846]   (a child)
#
# And from inside that child, opening /proc/<pid>/fdinfo of a process owned by THE SAME
# USER is "Permission denied". /proc/<pid>/fdinfo is guarded by ptrace_may_access, which
# requires CAP_SYS_PTRACE **in the target's user namespace**; being the same uid is not
# enough once there is a namespace boundary in between. So a hardened user unit cannot
# read its own user's DRM clients, which is the agent's entire GPU source.
#
# Bisected one directive at a time. Each of ProtectSystem=, ProtectHome=, PrivateTmp=,
# ProtectKernelTunables=, ProtectKernelLogs=, ProtectControlGroups=, ProtectHostname= and
# ProtectClock= took the count from 2 processes publishing DRM memory to 0. So did
# CapabilityBoundingSet=. IPAddressDeny= fails outright, because filtering addresses needs
# a BPF program the user manager has not been delegated. With the set below the unit stays
# in the initial user namespace, fdinfo is readable, and the agent reports what it sees.
#
# WHAT IS ACTUALLY GIVEN UP, stated plainly: the agent no longer gets a private /tmp, a
# read-only /usr or an inaccessible /home. What it keeps is everything that constrains a
# bug in a parser -- it cannot gain privileges, cannot open a socket that is not AF_UNIX,
# cannot make memory both writable and executable, cannot create a namespace, and is held
# to @system-service. And the thing those mount directives were defending against is
# narrower than it looks: this process already runs as the user, with the user's own
# credentials, so a compromised agent can do what a compromised anything in that session
# can do. It holds no capability, and the privileged half of this project is a separate
# process that takes none of its claims on trust.
#
# CapabilityBoundingSet= is gone for the same reason and costs nothing: a process started
# by a user manager has an empty capability set already. The line asserted what was
# already true, and asserting it required a namespace that broke the agent's own source.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

# The Wayland socket, the session bus and the system bus are all AF_UNIX. The agent opens
# no network socket. An X11 session reached over TCP rather than over its unix socket is
# not supported, deliberately: a display exported over the network is not a reliable
# statement about whether somebody is physically present.
RestrictAddressFamilies=AF_UNIX

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete @reboot @swap @cpu-emulation

[Install]
# Present so `systemctl --user enable` works. Nothing in the packaging invokes it.
WantedBy=graphical-session.target
